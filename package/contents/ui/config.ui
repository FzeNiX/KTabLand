   </item>
   <item row="1" column="1">
    <widget class="QLabel" name="modifierHint">
     <property name="text"><string>Hold this key, drag a window by its title bar and drop it on another window or on a tab bar to group them.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item row="2" column="0">
