   <item row="3" column="0">
    <widget class="QLabel" name="heightLabel">
     <property name="text"><string>Tab bar height:</string></property>
     <property name="buddy"><cstring>kcfg_TabBarHeight</cstring></property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QSpinBox" name="kcfg_TabBarHeight">
     <property name="suffix"><string> px</string></property>
     <property name="minimum"><number>22</number></property>
     <property name="maximum"><number>64</number></property>
