     <property name="suffix"><string> px</string></property>
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>16</number></property>
     <property name="toolTip"><string>The tab bar's color wraps around the rounded top corners of the window below it. Set it to the corner radius of your window decoration (0 to turn it off).</string></property>
